# Copy these values into your process environment. Django does not load this file automatically.

# Local development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SQLITE_PATH=blog

# Chat model: point this at a fully downloaded local bert-base-chinese directory.
CHAT_MODEL_DIR=models/bert-base-chinese
CHAT_MODEL_WEIGHTS=chat/good.bin
CHAT_MODEL_DEVICE=cpu
CHAT_MODEL_LOCAL_FILES_ONLY=true

# Neo4j knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Image-recognition model
PREDICT_MODEL_WEIGHTS=predict/model.pth
PREDICT_CLASS_INDICES=predict/class_indices.json
PREDICT_MODEL_DEVICE=cpu
